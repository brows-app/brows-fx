<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    Components are assemblies that tests stage and load in separate processes. They are not test projects,
    so they import the repository's properties directly instead of ..\Directory.Build.props.
  -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\Directory.Build.props" />
  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <ArtifactsPath>$(MSBuildThisFileDirectory)..\..\out\components</ArtifactsPath>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
